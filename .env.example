# Auto-Stream Configuration
# Copy this file to .env and fill in your values

# YouTube Streaming (Required)
YOUTUBE_STREAM_KEY=your_youtube_stream_key_here
YOUTUBE_STREAM_URL=rtmp://a.rtmp.youtube.com/live2

# Game Detection (Required)
GAME_EXECUTABLE=YourGame.exe

# Stream Settings (Optional)
CHECK_INTERVAL=10
STREAM_QUALITY=720p
STREAM_FRAMERATE=30
STREAM_BITRATE=3000k

# Discord Notifications (Optional)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_MESSAGE=🎮 {game_name} stream is now live!

# System (Optional)
FFMPEG_PATH=
AUTO_START=true
